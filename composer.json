{
    "name": "timmit/db-mysql",
    "description": "A simple DB layer in PHP for using MySQL(i)",
    "keywords": [
        "DB",
        "MySQL",
        "MySQLi",
        "database",
        "DB layer",
        "database layer"
    ],
    "license": "MIT",
    "homepage": "http://www.TiMMiT.nl/",
    "authors": [
        {
            "name": "Tim Schoondergang",
            "email": "Tim.Schoondergang@TiMMiT.nl",
            "homepage": "http://www.TiMMiT.nl"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.4.8",
        "phpstan/phpstan-strict-rules": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpunit/phpunit": "10.5.62"
    },
    "autoload": {
        "psr-4": {
            "TiMMiT\\MySQL\\": "src/TiMMiT/MySQL"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "test\\php\\phpunit\\": "test/php/phpunit"
        }
    }
}
